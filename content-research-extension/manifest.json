{
  "manifest_version": 3,
  "name": "Viral Lens – Content Research",
  "version": "1.0.0",
  "description": "Find viral and outlier content on YouTube, TikTok, Instagram, X, Reddit and LinkedIn, save it to a swipe file, and turn it into ideas for your own brand.",
  "action": {
    "default_title": "Open Viral Lens",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://www.linkedin.com/*",
    "https://api.anthropic.com/*"
  ]
}
